{
  "name": "sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:content && npm run build:sw",
    "watch": "npm run build -- --watch",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts' 'extension/src/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build:content": "esbuild extension/src/content.ts --bundle --format=iife --outfile=extension/content.js --log-level=warning",
    "build:sw": "esbuild extension/src/background.ts --bundle --format=esm --outfile=extension/background.js --log-level=warning"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0"
  }
}
